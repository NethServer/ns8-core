import json
import sys
import agent

rdb = agent.redis_connect(use_replica=True)
tunnel_config = rdb.hgetall("cluster/support_tunnel") or {}
subscription = rdb.hgetall("cluster/subscription") or {}

has_override = tunnel_config.get("key") and tunnel_config.get("secret")
has_subscription = subscription.get("provider") == "nsent" and subscription.get("system_id") and subscription.get("auth_token")

if not has_override and not has_subscription:
    agent.set_status('validation-failed')
    json.dump([{
        "field": "support_tunnel",
        "parameter": "support_tunnel",
        "value": "",
        "error": "tunnel_credentials_required",
    }], fp=sys.stdout)
    sys.exit(2)
