import agent
import agent.tasks
import cluster.smarthost
import os
import sys
import json



agent_id = os.environ['AGENT_ID']
data = json.load(sys.stdin)

values = {
    "port": data['port'],
    "host": data['host'],
    "username": data['username'],
    "password": data['password'],
    "enabled": '1' if data['enabled'] else '0',
    "encrypt_smtp": data['encrypt_smtp'],
    "tls_verify": '1' if data['tls_verify'] else '0'
}

rdb = agent.redis_connect(privileged=True)

# Remember the Mail module by UUID: its ID and host change on move or restore
mail_uuid = cluster.smarthost.find_mail_uuid(rdb, {
    **values,
    "mail_uuid": rdb.hget(agent_id + '/smarthost', 'mail_uuid'),
})

# Advertise the smarthost changes:
trx = rdb.pipeline()
trx.hset(agent_id + '/smarthost', mapping=values)
if mail_uuid:
    trx.hset(agent_id + '/smarthost', 'mail_uuid', mail_uuid)
else:
    trx.hdel(agent_id + '/smarthost', 'mail_uuid')
trx.publish(agent_id + '/event/smarthost-changed', json.dumps({
    'key': agent_id + '/smarthost',
}))
trx.execute()
