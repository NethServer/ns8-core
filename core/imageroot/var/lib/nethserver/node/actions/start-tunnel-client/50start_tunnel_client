import json
import os
import re
import subprocess
import sys
import time

import agent

SUPPORT_DIR = "/var/lib/nethserver/support-tunnel"
ENV_FILE = f"{SUPPORT_DIR}/support.env"
DEFAULT_URL = "wss://support.nethesis.it/api/tunnel"

# Values end up in a systemd EnvironmentFile: no whitespace, quotes or
# backslashes, so they cannot inject extra variables.
SAFE_VALUE = re.compile(r"^[A-Za-z0-9._:/@%+=,*?\[\]~^!#&()-]*$")
URL_VALUE = re.compile(r"^wss://[A-Za-z0-9.-]+(:[0-9]+)?(/[A-Za-z0-9._~/%-]*)?$")

node_id = os.environ["NODE_ID"]

rdb = agent.redis_connect(use_replica=True)
tunnel_config = rdb.hgetall("cluster/support_tunnel") or {}
subscription = rdb.hgetall("cluster/subscription") or {}

# Credentials default to the my subscription; cluster/support_tunnel
# key/secret is an explicit override.
system_key = tunnel_config.get("key", "")
system_secret = tunnel_config.get("secret", "")
if not system_key and not system_secret and subscription.get("provider") == "nsent":
    system_key = subscription.get("system_id", "")
    system_secret = subscription.get("auth_token", "")

support_url = tunnel_config.get("url") or DEFAULT_URL
exclude_patterns = tunnel_config.get("exclude_patterns", "")

if not system_key or not system_secret:
    print("ERROR: missing tunnel credentials: no nsent subscription and no cluster/support_tunnel key/secret", file=sys.stderr)
    sys.exit(1)

if not URL_VALUE.match(support_url):
    print("ERROR: invalid support tunnel url, a wss:// URL is required", file=sys.stderr)
    sys.exit(1)

for name, value in (("key", system_key), ("secret", system_secret), ("exclude_patterns", exclude_patterns), ("node_id", node_id)):
    if not SAFE_VALUE.match(value):
        print(f"ERROR: invalid characters in support tunnel {name}", file=sys.stderr)
        sys.exit(1)

# Tear down a previous session, then extract tunnel-client binary and
# plugins from core image
agent.run_helper("systemctl", "stop", "support-tunnel.service")
agent.run_helper("runagent", "-m", "node", "install-support-tunnel").check_returncode()

os.umask(0o077)
os.makedirs(SUPPORT_DIR, mode=0o700, exist_ok=True)
os.chmod(SUPPORT_DIR, 0o700)

support_env = {
    "SUPPORT_URL": support_url,
    "SYSTEM_KEY": system_key,
    "SYSTEM_SECRET": system_secret,
    "NODE_ID": node_id,
    "REDIS_ADDR": "127.0.0.1:6379",
    "USERS_DIR": f"{SUPPORT_DIR}/users.d",
    "DIAGNOSTICS_DIR": f"{SUPPORT_DIR}/diagnostics.d",
    "EXCLUDE_PATTERNS": exclude_patterns,
    "USERS_STATE_FILE": f"{SUPPORT_DIR}/users-state.json",
}
tmp_env = ENV_FILE + ".tmp"
fd = os.open(tmp_env, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as ofile:
    ofile.write("# Auto-generated by start-tunnel-client - do not edit manually.\n")
    for key, value in support_env.items():
        ofile.write(f"{key}={value}\n")
os.replace(tmp_env, ENV_FILE)

def run(*args):
    return subprocess.run(args, stdout=subprocess.PIPE, stderr=sys.stderr, text=True)

# Remove orphan accounts of a previous session before starting a new one,
# and make sure they are removed at boot after a crash.
agent.run_helper("systemctl", "daemon-reload").check_returncode()
agent.run_helper("systemctl", "enable", "support-tunnel-cleanup.service").check_returncode()
agent.run_helper("systemctl", "start", "support-tunnel-cleanup.service").check_returncode()
agent.run_helper("systemctl", "start", "support-tunnel.service").check_returncode()

def journal_since_start():
    return run("journalctl", "-u", "support-tunnel", "--since", "30 sec ago", "--no-pager").stdout

# Wait for the tunnel to actually connect (max 15 seconds)
connected = False
for _ in range(15):
    if run("systemctl", "is-active", "--quiet", "support-tunnel.service").returncode != 0:
        print("ERROR: support-tunnel.service failed to start", file=sys.stderr)
        print("\n".join(journal_since_start().splitlines()[-5:]), file=sys.stderr)
        sys.exit(1)
    if "WebSocket connected" in journal_since_start():
        connected = True
        break
    time.sleep(1)

if not connected:
    print("WARNING: tunnel service started but WebSocket connection not confirmed within 15s", file=sys.stderr)

services_count = 0
for match in re.finditer(r"Manifest sent with ([0-9]+)", journal_since_start()):
    services_count = int(match.group(1))

try:
    tunnel_pid = int(run("systemctl", "show", "-p", "MainPID", "--value", "support-tunnel.service").stdout.strip())
except ValueError:
    tunnel_pid = 0

wrdb = agent.redis_connect(privileged=True)
wrdb.hset(f"node/{node_id}/tunnel", mapping={
    "active": "true",
    "support_url": support_url,
    "connected": "true" if connected else "false",
    "services_count": str(services_count),
    "pid": str(tunnel_pid),
})

json.dump({
    "active": True,
    "node_id": node_id,
    "support_url": support_url,
    "connected": connected,
    "services": services_count,
    "pid": tunnel_pid,
}, fp=sys.stdout)
