import os
import pwd
import sys
import json
import agent

odir = '/etc/nethserver/tun'
request = json.load(sys.stdin)
tun = request['tun']
ip = request['ip']
envfile = f'{odir}/{tun}.env'

try:
    env = agent.read_envfile(envfile)
except FileNotFoundError:
    env = {}

# Recent kernels (upstream ffdf678dd166, in Debian 13 since 6.12.117)
# refuse a rootless container to open a tun without owner. The owner is
# the rootless module that asks for the tun. It comes from the task
# identity, which a module cannot choose.
owner = env.get('OWNER', '')
task_user = os.environ.get('AGENT_TASK_USER', '')
if task_user.startswith('module/'):
    module_id = task_user.removeprefix('module/')
    try:
        caller = str(pwd.getpwnam(module_id).pw_uid)
    except KeyError:
        # A rootfull module has no user and needs no owner
        caller = ''
        print(agent.SD_INFO + f'No user for {module_id}: the tun {tun} keeps its owner', file=sys.stderr)
    if caller and owner and caller != owner:
        print(agent.SD_ERR + f'The tun {tun} belongs to uid {owner}, not to {module_id}', file=sys.stderr)
        sys.exit(1)
    owner = caller or owner

env['TUN'] = tun
env['IP'] = ip
if owner:
    env['OWNER'] = owner

os.makedirs(odir, exist_ok=True)
agent.write_envfile(envfile, env)
# Never restart: a running module holds the tun, and it cannot be created again under it
agent.run_helper('systemctl', 'enable', '--now', f'tun-manager@{tun}').check_returncode()
