import os
import agent
import sys

# Iterate over environment variables
for image_old in os.environ:

    if not image_old.startswith('PREV_'):
        continue # not a PREV image key, skip it.

    if not image_old.endswith('_IMAGE'):
        continue # we want to skip *DIGEST and ID keys

    # Skip a missing previous image: earlier core releases stored the
    # string "None" when an image was added by the update
    image_old_url = os.environ.get(image_old)
    if not image_old_url or image_old_url == 'None':
        continue

    # Check if the new image is different
    image_new_url = os.environ.get(image_old.removeprefix('PREV_'))
    if image_new_url != image_old_url:
        print(f"Removing {image_old_url} (differs from {image_new_url})", file=sys.stderr)
        agent.run_helper('podman', 'image', 'rm', image_old_url)

# Handle removal of the old image URL
image_old = os.environ.get('PREV_IMAGE_URL')
image_new = os.environ.get('IMAGE_URL')
if image_old and image_old != image_new:
    print(f"Removing {image_old} (differs from {image_new})", file=sys.stderr)
    agent.run_helper('podman', 'image', 'rm', image_old)
