[Unit]
Description=Support tunnel client
After=network-online.target support-tunnel-cleanup.service
Wants=network-online.target

[Service]
Type=simple
# Configuration and credentials are read from the environment only
EnvironmentFile=/var/lib/nethserver/support-tunnel/support.env
UMask=0077
ExecStart=/usr/local/bin/tunnel-client
ExecStopPost=/usr/local/bin/tunnel-client --cleanup-only
TimeoutStopSec=90
Restart=no
RuntimeMaxSec=7d
SyslogIdentifier=support-tunnel
