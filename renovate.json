{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>NethServer/.github:ns8-automerge"
  ],
  "enabledManagers": [
    "npm",
    "gomod",
    "regex"
  ],
  "packageRules": [
    {
      "description": "Suppress PRs for major and minor updates",
      "matchDatasources": ["docker", "github-tags"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    },
    {
      "description": "Go major updates that change the import path need a manual code migration",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "github.com/appleboy/gin-jwt/v2"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": [
        "build-image.sh"
      ],
      "matchStrings": [
        "https://github\\.com/(?<depName>.+?)/releases/download/(?<currentValue>.+?)/logcli-linux-amd64\\.zip"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
